# Producao: use somente URLs HTTPS e configure os valores reais no Render.
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres?sslmode=require
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sua-chave-publicavel
AUTH_REQUIRED=true
COOKIE_SECURE=true
MFA_LOGIN_ENFORCE=true
PWNED_PASSWORD_CHECK=true
# Opcional no Render: o dominio onrender.com e detectado automaticamente.
# Defina somente para usar um dominio personalizado.
APP_BASE_URL=

# Gmail (opcional; configure quando a integracao for ativada)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://seu-servico.onrender.com/auth/gmail/callback
TOKEN_ENCRYPTION_KEY=
OAUTH_STATE_SECRET=
GMAIL_AUTO_SYNC=false

# Exportação de currículo/carta: gratuito mostra somente prévia.
# O checkout pode conceder acesso via Supabase app_metadata ou allowlist.
DOCUMENT_EXPORT_PRICE=
DOCUMENT_EXPORT_PRICE_CENTS=990
DOCUMENT_EXPORT_CHECKOUT_URL=
DOCUMENT_EXPORT_ALLOWED_EMAILS=

# Mercado Pago Checkout Pro (opcional; tem prioridade sobre InfinitePay)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# InfinitePay Checkout (o preço é informado em centavos; ex.: 990 = R$ 9,90)
INFINITEPAY_HANDLE=
INFINITEPAY_EXPORT_PRICE_CENTS=
