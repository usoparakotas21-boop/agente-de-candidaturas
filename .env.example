# Producao: use somente URLs HTTPS e configure os valores reais no Railway.
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres?sslmode=require
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sua-chave-publicavel
AUTH_REQUIRED=true
COOKIE_SECURE=true
PWNED_PASSWORD_CHECK=true
# URL pública usada em callbacks, links de e-mail e retornos do pagamento.
APP_BASE_URL=https://candidaturacerta.com.br

# Somente staging: suspende rotinas automaticas. A inicializacao ainda pode
# criar/alterar tabelas; use exclusivamente um banco de testes isolado.
STAGING_DISABLE_BACKGROUND_WORKERS=false

# Gmail (opcional; configure quando a integracao for ativada)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Deixe vazio para usar APP_BASE_URL/auth/gmail/callback automaticamente.
GOOGLE_REDIRECT_URI=
TOKEN_ENCRYPTION_KEY=
OAUTH_STATE_SECRET=
GMAIL_AUTO_SYNC=false

# Outlook (opcional; o callback precisa estar cadastrado também na Microsoft).
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
# Deixe vazio para usar APP_BASE_URL/auth/outlook/callback automaticamente.
OUTLOOK_REDIRECT_URI=
OUTLOOK_AUTO_SYNC=false

# Recibos pós-pagamento (opcional; SMTP transacional do Brevo ou equivalente)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
# Opcional: quando definido, recibos, documentos e candidaturas usam a API HTTPS da Brevo.
# Mantenha a chave somente no painel de segredos do provedor (nunca no Git).
BREVO_API_KEY=

# Exportação de currículo/carta: gratuito mostra somente prévia.
# O checkout pode conceder acesso via Supabase app_metadata ou allowlist.
DOCUMENT_EXPORT_PRICE=
DOCUMENT_EXPORT_PRICE_CENTS=990
DOCUMENT_EXPORT_CHECKOUT_URL=
DOCUMENT_EXPORT_ALLOWED_EMAILS=

# Mercado Pago Checkout Pro
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Rate limiting compartilhado entre instâncias Render (Upstash Redis REST).
# Depois de validar o serviço, defina RATE_LIMIT_DISTRIBUTED_REQUIRED=true.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_DISTRIBUTED_REQUIRED=false

# Link HTTPS opcional de demonstração YouTube ou Vimeo; a seção fica oculta até ser definido.
DEMO_VIDEO_URL=

# Apify: integração desativada até que o Dataset e a autorização sejam registrados.
APIFY_API_TOKEN=
APIFY_DATASET_ID=
APIFY_SOURCE_APPROVED=false
APIFY_PERMISSION_EVIDENCE=
APIFY_TERMS_REFERENCE=https://console.apify.com/actors/hKByXkMQaC5Qt9UMN/info/readme
APIFY_ROBOTS_REVIEW=

# Coleta: fallback temporário para validar a interface quando todas as fontes falharem.
# Ative apenas para testar a interface com dados marcados como [Diagnóstico].
JOB_CAPTURE_DIAGNOSTIC_FALLBACK=false

# ScraperAPI (opcional; usado somente por Catho, InfoJobs e Sólides)
# Deixe vazio para manter essas fontes no acesso direto.
SCRAPERAPI_KEY=
