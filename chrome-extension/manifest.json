{
  "manifest_version": 3,
  "name": "Candidatura Certa — Copiloto",
  "short_name": "Candidatura Certa",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "description": "Prepara candidaturas em formulários permitidos, com revisão e envio controlados por você.",
  "homepage_url": "https://candidaturacerta.com.br/",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Candidatura Certa — preparar candidatura",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "sidePanel", "clipboardWrite"],
  "optional_permissions": ["cookies"],
  "optional_host_permissions": [
    "https://candidaturacerta.com.br/*",
    "https://agente-de-candidaturas.onrender.com/*",
    "https://*.gupy.io/*",
    "https://*.vagas.com.br/*",
    "https://*.infojobs.com.br/*"
  ]
}
