{
  "manifest_version": 3,
  "name": "Candidatura Certa — candidaturas assistidas",
  "short_name": "Candidatura Certa",
  "version": "0.6.0",
  "minimum_chrome_version": "116",
  "description": "Prepara candidaturas em formulários permitidos, com revisão e envio controlados por você.",
  "action": {
    "default_title": "Candidatura Certa — preparar candidatura",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "sidePanel", "clipboardWrite"],
  "optional_permissions": ["cookies"],
  "optional_host_permissions": [
    "https://candidaturacerta.com.br/*",
    "https://agente-de-candidaturas.onrender.com/*",
    "https://*.gupy.io/*",
    "https://*.vagas.com.br/*",
    "https://*.infojobs.com.br/*"
  ]
}
