{
  "name": "candidatura-certa-motion-video",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "start": "remotion studio src/index.ts",
    "build-video": "remotion render src/index.ts CandidaturaCerta candidatura_certa_apresentacao.mp4 --codec=h264 --concurrency=2",
    "build-video:preview": "remotion render src/index.ts CandidaturaCerta candidatura_certa_preview.mp4 --frames=0-450 --codec=h264"
  },
  "dependencies": {
    "@remotion/media": "^4.0.238",
    "@remotion/tailwind": "^4.0.238",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.238"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
